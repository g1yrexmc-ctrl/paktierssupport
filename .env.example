# Required: Discord Developer Portal > Bot > Reset Token / Copy Token
BOT_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN_HERE

# Required: Discord Developer Portal > General Information > Application ID
CLIENT_ID=PASTE_YOUR_DISCORD_APPLICATION_ID_HERE

# Optional but recommended while testing: registers slash commands only in this server (instant updates).
# Leave blank for global commands (global propagation can take longer).
GUILD_ID=PASTE_TEST_SERVER_ID_OR_LEAVE_BLANK

# Required: choose a long, unique dashboard password; do not reuse a Discord password.
DASHBOARD_PASSWORD=replace-this-with-a-long-random-password

# Required: long random secret used to sign dashboard sessions.
SESSION_SECRET=replace-this-with-at-least-32-random-characters

# Railway: attach a Volume mounted at /data, then set DATA_DIR=/data.
# The application also recognizes RAILWAY_VOLUME_MOUNT_PATH automatically.
DATA_DIR=/data

# Railway injects PORT automatically; no need to define it manually.
# NODE_ENV=production

# Optional: enable only after enabling Server Members Intent in the Discord Developer Portal.
ENABLE_MEMBER_EVENTS=false

# Optional: enable only after enabling Message Content Intent in the Discord Developer Portal.
ENABLE_MESSAGE_CONTENT_LOGS=false
